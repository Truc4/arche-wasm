/// Side-scroller proving the `camera` device as a FOLLOW-CAM. A controllable player walks through a world
/// of solid-colour blocks in float WORLD coordinates, drawn through `camera.to_screen` → `gfx.rect`. ←/→
/// move the PLAYER (not the camera); the camera holds still while the player roams a central deadzone, then
/// scrolls to trail the player once it nears a screen edge — the world scrolls under a fixed-on-screen
/// player, which is the "camera follows" signal. One clean ABSTRACT palette (a cool indigo depth-ramp plus
/// a warm player accent) — shapes, not scenery. See docs/scenery.md for the art direction and roadmap.
///
/// NOTE on structure: the player's components are ENTIRELY SEPARATE from the scenery `Prop`'s (its own
/// `ppx`/`prx`/`pry`, its own `draw_player` pass) and share nothing. In arche today, writing a component
/// that is SHARED across two archetypes inside an effectful `map … eff` fan misbehaves (the write is dropped
/// or broadcast across pools), so a scenery/player split that shared `pos`/`rx`/`ry` collapsed the world to
/// one point. Single-archetype column writes (like `Camera.eye.x`) are fine — hence the full separation.
#import { gfx camera vec os }

W :: 480;
H :: 360;
SPEED    :: 3.0;    // player world-units moved per frame while a key is held
DEADZONE :: 140.0;  // half-width (world units) the player roams before the camera scrolls to follow it
PLAYER_Y :: 278.0;  // the player's fixed world y — it walks the ground line (no jumping yet)
PW :: 28;           // player width  (px)
PH :: 44;           // player height (px)

/// Viewport centre in pixels — where the camera's eye lands on screen.
CENTRE(x, y) :: (240.0, 180.0);

/// Palette — one clean, ABSTRACT system: a flat floor, a cool indigo value-ramp of building shades
/// (`S1` darkest … `S6` lightest) for variety/depth, and a single warm accent for the player so it reads as
/// the subject. Swap this block to re-theme everything; nothing else hard-codes a colour.
CANVAS :: 0x12131c;   // background fill (the "sky")
FLOOR  :: 0x242742;   // the one long flat floor rectangle
S1     :: 0x2b2f4e;   // building shades, dark → light
S2     :: 0x343a5e;
S3     :: 0x3f4570;
S4     :: 0x4b5183;
S5     :: 0x585f96;
S6     :: 0x656caa;
PLAYER :: 0xf2c14e;   // the player — the one warm accent

rw     :: int;
rh     :: int;
rcolor :: int;
rx     :: int;
ry     :: int;
ppx    :: float;   // player world x (its own scalar — see the structure note above)
prx    :: int;     // player screen top-left x
pry    :: int;     // player screen top-left y
handle :: window;
bg     :: int;

/// A solid-colour rectangle in world space: `pos` (world centre), `rw`/`rh` (pixel size), `rcolor`, and the
/// projected screen top-left `rx`/`ry` that `gfx.rect` draws.
Prop :: arche { pos, rw, rh, rcolor, rx, ry }
/// The player, entirely separate from Prop: world x `ppx`, projected screen top-left `prx`/`pry`. Size and
/// colour are the PW/PH/PLAYER constants; `draw_player` fills it after the scenery so it sits on top.
Player :: arche { ppx, prx, pry }
Window :: arche { handle, bg }
Framebuffer :: arche { framebuffer :: [W * H]int }

[10]Prop(9);
[1]Player(1);
[1]Window ?abort;
[1]Framebuffer(1);
[1]Camera(1);
[1]Closed;

boot :: system eff {
  gfx.open(W, H, "arche-wasm scene")(win:);
  insert(Window { handle: win, bg: CANVAS });
}

// The world reads as a clear side-scroller: one long flat FLOOR rectangle whose top sits at screen y=240,
// and background buildings of various sizes/shades all BOTTOM-ALIGNED to that line (world y = 300 − rh/2, so
// each rises from the floor), spaced apart along x. The player starts at world x=700, standing in a gap on
// the floor, with the camera centred on it.
seed :: system {
  //             floor    b1     b2     b3     b4     b5     b6     b7      b8
  Prop.pos.x  = { 700.0,   180.0, 330.0, 470.0, 600.0, 820.0, 980.0, 1180.0, 1360.0 };
  Prop.pos.y  = { 360.0,   200.0, 240.0, 215.0, 255.0, 225.0, 245.0, 205.0,  235.0  };
  Prop.rw     = { 3400,    90,    140,   70,    110,   80,    180,   100,    130    };
  Prop.rh     = { 120,     200,   120,   170,   90,    150,   110,   190,    130    };
  Prop.rcolor = { FLOOR,   S2,    S5,    S1,    S4,    S3,    S6,    S2,     S4     };

  Player.ppx = { 700.0 };

  Camera.eye.x = { 700.0 };
  Camera.eye.y = { 240.0 };
  Camera.zoom  = { 1.0 };
}

/// Walk the player left/right with the input axis. `ppx` is the player's own scalar, so the write sticks.
walk :: system eff {
  map (query { handle }) eff {
    gfx.axis_x(handle)(dx:);
    map (query { ppx })(ppx) eff {
      ppx = ppx + float(dx) * SPEED;
    };
  };
}

/// Deadzone follow-cam: the player roams ±DEADZONE world units of the eye freely (camera still); past that
/// the eye snaps to trail the player at the deadzone edge, so the world scrolls only near the screen edges.
follow :: system eff {
  map (query { ppx }) eff {
    map (query { eye, zoom })(eye) eff {
      if (ppx - eye.x > DEADZONE) {
        eye.x = ppx - DEADZONE;
      }
      if (eye.x - ppx > DEADZONE) {
        eye.x = ppx + DEADZONE;
      }
    };
  };
}

/// Project the scenery props from world to screen pixels for `gfx.rect`.
project :: system eff {
  map (query { eye, zoom }) eff {
    map (query { pos, rw, rh, rx, ry })(rx, ry) eff {
      s := camera.to_screen(pos, eye, zoom, CENTRE);
      rx = i32(s.x) - rw / 2;
      ry = i32(s.y) - rh / 2;
    };
  };
}

/// Project the player from its (ppx, PLAYER_Y) world point (assembled with `vec.mk`) to its own screen
/// top-left `prx`/`pry` — a separate column from the scenery's `rx`/`ry`.
project_player :: system eff {
  map (query { eye, zoom }) eff {
    map (query { ppx, prx, pry })(prx, pry) eff {
      s := camera.to_screen(vec.mk(ppx, PLAYER_Y), eye, zoom, CENTRE);
      prx = i32(s.x) - PW / 2;
      pry = i32(s.y) - PH / 2;
    };
  };
}

/// Draw the player rectangle (PW×PH in `PLAYER`) into the framebuffer, clamped to the window. Scheduled
/// after `gfx.rect`, so the player sits on top of the scenery.
draw_player :: system (query { framebuffer })(framebuffer) eff {
  map (query { prx, pry }) eff {
    y0 := pry;
    y1 := pry + PH;
    if (y0 < 0) {
      y0 = 0;
    }
    if (y1 > H) {
      y1 = H;
    }
    x0 := prx;
    x1 := prx + PW;
    if (x0 < 0) {
      x0 = 0;
    }
    if (x1 > W) {
      x1 = W;
    }
    yy := y0;
    for (; yy < y1;) {
      xx := x0;
      for (; xx < x1;) {
        framebuffer[yy * W + xx] = PLAYER;
        xx = xx + 1;
      }
      yy = yy + 1;
    }
  };
}

done :: map (Closed) eff {
  os.exit(0)(_:);
}

#run {
  seq(
    {
      boot,
      seed,
      forever(seq({ walk, follow, project, project_player, gfx.clear, gfx.rect, draw_player, gfx.present, gfx.poll, done })),
    },
  )
}
